<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_web</name>
  <version>0.1.0</version>
  <description>
    Trang dieu khien robot bam nguoi qua trinh duyet (dien thoai / laptop cung mang):
    khoi dong / tat he thong, hoc nguoi, bat / tam dung bam, dung khan. Chi doc topic va goi
    service co san — KHONG BAO GIO ghi /cmd_vel.
  </description>

  <maintainer email="thad91738@gmail.com">thaihoa</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>python3-numpy</depend>
  <exec_depend>python3-opencv</exec_depend>

  <buildtool_depend>ament_python</buildtool_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
