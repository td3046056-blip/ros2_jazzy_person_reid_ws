<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 
    HINH DANG DUNG:
    - 2 banh chinh nam o 2 ben TRAI/PHAI (truc X)
    - Khoang cach ngang 2 banh chinh = 40cm (wheel_track = truc X)
    - Chieu dai khung xe (57cm) = truc Y (doc theo huong di chuyen)
    - Chieu rong khung xe (46cm) = truc X (ngang, noi 2 banh chinh)
    - Banh nho linh dong o phia sau (-Y)
  -->

  <!-- Dimensions -->
  <xacro:property name="wheel_radius" value="0.06"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_track" value="0.40"/>    <!-- 40cm - ngang, truc X -->
  <xacro:property name="wheelbase" value="0.245"/>      <!-- 24.5cm - doc, truc Y -->
  <xacro:property name="caster_radius" value="0.0225"/>
  <xacro:property name="caster_track" value="0.31"/>    <!-- 31cm - ngang, truc X -->

  <xacro:property name="chassis_length" value="0.57"/>  <!-- 57cm - DOC, truc Y -->
  <xacro:property name="chassis_width" value="0.46"/>    <!-- 46cm - NGANG, truc X -->
  <xacro:property name="chassis_height" value="0.05"/>
  <xacro:property name="ground_clearance" value="0.04"/>
  <xacro:property name="equipment_height" value="0.26"/>
  <xacro:property name="corner_radius" value="0.04"/>

  <!-- Masses -->
  <xacro:property name="chassis_mass" value="5.0"/>
  <xacro:property name="wheel_mass" value="0.5"/>
  <xacro:property name="caster_mass" value="0.2"/>
  <xacro:property name="plate_mass" value="0.3"/>

  <!-- Inertia macros -->
  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(h*h + d*d)/12}" ixy="0.0" ixz="0.0"
               iyy="${m*(w*w + d*d)/12}" iyz="0.0"
               izz="${m*(w*w + h*h)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r + h*h)/12}" ixy="0.0" ixz="0.0"
               iyy="${m*(3*r*r + h*h)/12}" iyz="0.0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2*m*r*r/5}" ixy="0.0" ixz="0.0"
               iyy="${2*m*r*r/5}" iyz="0.0"
               izz="${2*m*r*r/5}"/>
    </inertial>
  </xacro:macro>

  <!-- ================= BASE LINK ================= -->
  <!-- 
    Khung xe: chieu dai (57cm) theo truc Y, chieu rong (46cm) theo truc X
    4 goc bo tron
  -->
  <link name="base_link">

    <!-- THANH NGANG (truc X) - 2 thanh o trai va phai -->
    <!-- Thanh phai (+X) -->
    <visual>
      <origin xyz="${chassis_width/2 - 0.01} 0 ${ground_clearance + chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 ${chassis_length - 2*corner_radius} ${chassis_height}"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="${chassis_width/2 - 0.01} 0 ${ground_clearance + chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 ${chassis_length - 2*corner_radius} ${chassis_height}"/>
      </geometry>
    </collision>

    <!-- Thanh trai (-X) -->
    <visual>
      <origin xyz="${-chassis_width/2 + 0.01} 0 ${ground_clearance + chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 ${chassis_length - 2*corner_radius} ${chassis_height}"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="${-chassis_width/2 + 0.01} 0 ${ground_clearance + chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 ${chassis_length - 2*corner_radius} ${chassis_height}"/>
      </geometry>
    </collision>

    <!-- THANH DOC (truc Y) - 2 thanh truoc va sau -->
    <!-- Thanh truoc (+Y) -->
    <visual>
      <origin xyz="0 ${chassis_length/2 - 0.01} ${ground_clearance + chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_width - 2*corner_radius} 0.02 ${chassis_height}"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0 ${chassis_length/2 - 0.01} ${ground_clearance + chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_width - 2*corner_radius} 0.02 ${chassis_height}"/>
      </geometry>
    </collision>

    <!-- Thanh sau (-Y) -->
    <visual>
      <origin xyz="0 ${-chassis_length/2 + 0.01} ${ground_clearance + chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_width - 2*corner_radius} 0.02 ${chassis_height}"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0 ${-chassis_length/2 + 0.01} ${ground_clearance + chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_width - 2*corner_radius} 0.02 ${chassis_height}"/>
      </geometry>
    </collision>

    <!-- 4 GOC BO TRON (cylinder) -->
    <!-- Goc truoc-phai (+X, +Y) -->
    <visual>
      <origin xyz="${chassis_width/2 - corner_radius} ${chassis_length/2 - corner_radius} ${ground_clearance + chassis_height/2}" rpy="0 0 ${pi/4}"/>
      <geometry><cylinder radius="${corner_radius}" length="${chassis_height}"/></geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="${chassis_width/2 - corner_radius} ${chassis_length/2 - corner_radius} ${ground_clearance + chassis_height/2}" rpy="0 0 ${pi/4}"/>
      <geometry><cylinder radius="${corner_radius}" length="${chassis_height}"/></geometry>
    </collision>

    <!-- Goc truoc-trai (-X, +Y) -->
    <visual>
      <origin xyz="${-chassis_width/2 + corner_radius} ${chassis_length/2 - corner_radius} ${ground_clearance + chassis_height/2}" rpy="0 0 ${-pi/4}"/>
      <geometry><cylinder radius="${corner_radius}" length="${chassis_height}"/></geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="${-chassis_width/2 + corner_radius} ${chassis_length/2 - corner_radius} ${ground_clearance + chassis_height/2}" rpy="0 0 ${-pi/4}"/>
      <geometry><cylinder radius="${corner_radius}" length="${chassis_height}"/></geometry>
    </collision>

    <!-- Goc sau-phai (+X, -Y) -->
    <visual>
      <origin xyz="${chassis_width/2 - corner_radius} ${-chassis_length/2 + corner_radius} ${ground_clearance + chassis_height/2}" rpy="0 0 ${3*pi/4}"/>
      <geometry><cylinder radius="${corner_radius}" length="${chassis_height}"/></geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="${chassis_width/2 - corner_radius} ${-chassis_length/2 + corner_radius} ${ground_clearance + chassis_height/2}" rpy="0 0 ${3*pi/4}"/>
      <geometry><cylinder radius="${corner_radius}" length="${chassis_height}"/></geometry>
    </collision>

    <!-- Goc sau-trai (-X, -Y) -->
    <visual>
      <origin xyz="${-chassis_width/2 + corner_radius} ${-chassis_length/2 + corner_radius} ${ground_clearance + chassis_height/2}" rpy="0 0 ${-3*pi/4}"/>
      <geometry><cylinder radius="${corner_radius}" length="${chassis_height}"/></geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="${-chassis_width/2 + corner_radius} ${-chassis_length/2 + corner_radius} ${ground_clearance + chassis_height/2}" rpy="0 0 ${-3*pi/4}"/>
      <geometry><cylinder radius="${corner_radius}" length="${chassis_height}"/></geometry>
    </collision>

    <!-- TAM KHUNG -->
    <visual>
      <origin xyz="0 0 ${ground_clearance + chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_width - 0.02} ${chassis_length - 0.02} ${chassis_height}"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${ground_clearance + chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_width - 0.02} ${chassis_length - 0.02} ${chassis_height}"/>
      </geometry>
    </collision>

    <xacro:box_inertia m="${chassis_mass}" w="${chassis_width}" h="${chassis_height}" d="${chassis_length}"/>
  </link>

  <!-- Battery -->
  <link name="battery_box">
    <visual>
      <origin xyz="0 0 ${ground_clearance + chassis_height + 0.045}" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.18 0.09"/>
      </geometry>
      <material name="battery_green"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${ground_clearance + chassis_height + 0.045}" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.18 0.09"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="battery_joint" type="fixed">
    <parent link="base_link"/>
    <child link="battery_box"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Top plate -->
  <link name="top_plate">
    <visual>
      <origin xyz="0 0 ${equipment_height - 0.01}" rpy="0 0 0"/>
      <geometry>
        <box size="0.38 0.48 0.02"/>
      </geometry>
      <material name="transparent"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${equipment_height - 0.01}" rpy="0 0 0"/>
      <geometry>
        <box size="0.38 0.48 0.02"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${plate_mass}" w="0.38" h="0.02" d="0.48"/>
  </link>
  <joint name="top_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_plate"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Standoffs -->
  <xacro:macro name="standoff" params="x y z">
    <link name="standoff_${x}_${y}">
      <visual>
        <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.005" length="${equipment_height - ground_clearance - chassis_height - 0.02}"/>
        </geometry>
        <material name="grey"/>
      </visual>
    </link>
    <joint name="standoff_joint_${x}_${y}" type="fixed">
      <parent link="base_link"/>
      <child link="standoff_${x}_${y}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:standoff x="0.15" y="0.20" z="${ground_clearance + chassis_height + (equipment_height - ground_clearance - chassis_height)/2 - 0.01}"/>
  <xacro:standoff x="0.15" y="-0.20" z="${ground_clearance + chassis_height + (equipment_height - ground_clearance - chassis_height)/2 - 0.01}"/>
  <xacro:standoff x="-0.15" y="0.20" z="${ground_clearance + chassis_height + (equipment_height - ground_clearance - chassis_height)/2 - 0.01}"/>
  <xacro:standoff x="-0.15" y="-0.20" z="${ground_clearance + chassis_height + (equipment_height - ground_clearance - chassis_height)/2 - 0.01}"/>

  <!-- ================= MAIN WHEELS (Front = +Y) ================= -->
  <xacro:macro name="main_wheel" params="prefix x y">
    <link name="${prefix}_wheel_link">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- 2 banh chinh: nam o 2 ben (truc X), phia truoc (+Y) -->
  <!-- wheel_track = 40cm = khoang cach ngang (truc X) -->
  <xacro:main_wheel prefix="front_left" x="${wheel_track/2}" y="${wheelbase/2}"/>
  <xacro:main_wheel prefix="front_right" x="${-wheel_track/2}" y="${wheelbase/2}"/>

  <!-- ================= CASTER WHEELS (Rear = -Y) ================= -->
  <xacro:macro name="caster_wheel" params="prefix x y">
    <link name="${prefix}_caster_mount_link">
      <visual>
        <geometry>
          <box size="0.04 0.04 0.02"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.04 0.04 0.02"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>

    <joint name="${prefix}_caster_mount_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_caster_mount_link"/>
      <origin xyz="${x} ${y} ${caster_radius + 0.01}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="${prefix}_caster_wheel_link">
      <visual>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
    </link>

    <joint name="${prefix}_caster_wheel_joint" type="continuous">
      <parent link="${prefix}_caster_mount_link"/>
      <child link="${prefix}_caster_wheel_link"/>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- 2 banh nho o phia sau (-Y) -->
  <!-- caster_track = 31cm = khoang cach ngang (truc X) -->
  <xacro:caster_wheel prefix="rear_left" x="${caster_track/2}" y="${-wheelbase/2}"/>
  <xacro:caster_wheel prefix="rear_right" x="${-caster_track/2}" y="${-wheelbase/2}"/>

</robot>
