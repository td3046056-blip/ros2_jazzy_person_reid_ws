<?xml version="1.0"?>
<package format="3">
  <name>person_follow_robot</name>
  <version>0.1.0</version>
  <description>Bringup and safe distance controller for an enrolled-person-following BW-DR03 robot.</description>
  <maintainer email="thad91738@gmail.com">thadn</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>person_follow_identity</exec_depend>
  <exec_depend>bw_dr03_ros2</exec_depend>

  <!-- Needed only for simulation launch -->
  <exec_depend>robot_simulation</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
